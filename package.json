{
  "name": "canutell",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx sim/src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "loadtest": "tsx apps/server/src/tools/loadtest.ts",
    "serve": "tsx apps/server/src/main.ts",
    "serve:dev": "CLOCK_SPEED=1 FILL_BOTS_MS=5000 tsx apps/server/src/main.ts",
    "web": "pnpm --filter @canutell/web dev",
    "web:build": "pnpm --filter @canutell/web build",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:status": "tsx packages/db/src/cli.ts status",
    "db:derive": "tsx packages/db/src/cli.ts derive",
    "db:purge": "tsx packages/db/src/cli.ts purge",
    "protocol:schema": "tsx packages/protocol/scripts/export-schema.ts",
    "consent:docs": "tsx packages/protocol/scripts/export-consent.ts",
    "db:latency-model": "tsx packages/db/src/cli.ts latency-model",
    "protocol:fixtures": "tsx sim/src/fixtures.ts",
    "agents:serve": "cd services/agents && uv run python -m canutell_agents",
    "agents:test": "cd services/agents && uv run pytest -q",
    "agents:lint": "cd services/agents && uv run ruff format --check . && uv run ruff check . && uv run pyright",
    "db:humanlikeness": "tsx packages/db/src/cli.ts humanlikeness",
    "db:integrity": "tsx packages/db/src/cli.ts integrity",
    "db:delete-account": "tsx packages/db/src/cli.ts delete-account",
    "ops:invite": "tsx packages/db/src/cli.ts invite",
    "ops:report": "tsx packages/db/src/cli.ts report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
