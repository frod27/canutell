{
  "name": "@canutell/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Server-authoritative CANUTELL game server: WebSockets, matchmaking, timers, per-seat views.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "start:dist": "CANUTELL_MIGRATIONS_DIR=dist/migrations node dist/server.mjs"
  },
  "dependencies": {
    "@canutell/bots": "workspace:*",
    "@canutell/db": "workspace:*",
    "@canutell/engine": "workspace:*",
    "@canutell/protocol": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "ws": "^8.22.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@canutell/sim": "workspace:*",
    "@electric-sql/pglite": "0.5.13",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.2"
  }
}
